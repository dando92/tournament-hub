# Copy to .env. Every value below is the local default; nothing here is a
# secret, and nothing here is suitable for a deployment.

# --- Identity and access -----------------------------------------------------
# The first administrator, created by the migration runner on an empty database.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost,http://localhost:5173

# --- PostgreSQL --------------------------------------------------------------
# The host values are what a process started from a shell uses. Inside Compose
# the services reach postgres by service name and ignore DATABASE_HOST.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=tournament_hub
DATABASE_PASSWORD=tournament_hub
DATABASE_NAME=tournament_hub
DATABASE_SSL=false

# --- Redis -------------------------------------------------------------------
# Pub/Sub carries replaceable live messages only. Nothing authoritative.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
LIVE_EVENT_CHANNEL=tournament-hub.live

# --- Published ports ---------------------------------------------------------
POSTGRES_PORT=5432
API_PORT=3000
REALTIME_PORT=3003
FRONTEND_PORT=80

# --- Browser gateway ---------------------------------------------------------
# The frontend's nginx is the single browser gateway; these are the paths it
# proxies, baked into the page at container start.
PUBLIC_API_URL=/api/
PUBLIC_REALTIME_URL=/realtime/

# --- Local fixture -----------------------------------------------------------
# A deterministic tournament written on an empty database, so a fresh clone has
# something to look at. Turn it off for a real installation.
LOCAL_FIXTURE_ENABLED=true
LOCAL_FIXTURE_TOURNAMENT_NAME=Local E2E Tournament

# --- Start.gg import ---------------------------------------------------------
STARTGG_API_URL=https://api.start.gg/gql/alpha
STARTGG_PER_PAGE=64
STARTGG_MIN_INTERVAL_MS=1000

# --- Measurement -------------------------------------------------------------
# One NDJSON line per request, with the number of queries it issued.
REQUEST_TIMING_ENABLED=false
